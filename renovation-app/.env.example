# ===== 复制本文件为 .env 并填写 =====

# 出图服务商：tencent（腾讯混元/AI绘画，国内推荐）或 openai
PROVIDER=tencent

# ===== 腾讯云（PROVIDER=tencent 时填这三个）=====
# 在 腾讯云控制台 → 访问管理(CAM) → API密钥管理 新建获取
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# 地域，默认广州；AI绘画服务一般在 ap-guangzhou
TENCENT_REGION=ap-guangzhou

# ===== OpenAI（PROVIDER=openai 时才用）=====
# OpenAI API Key。在 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=

# OpenAI 接口地址（可选）。
# 国内服务器无法直连 OpenAI 时，可填写兼容 OpenAI 接口的中转/代理地址。
OPENAI_BASE_URL=https://api.openai.com/v1

# 图像模型（可选，默认 gpt-image-1，即俗称的 GPT 图像模型）
OPENAI_IMAGE_MODEL=gpt-image-1

# 出图质量（可选）：low / medium / high / auto。质量越高越慢、越贵
OPENAI_IMAGE_QUALITY=medium

# 服务端口（可选，默认 3000）
PORT=3000

# 演示模式：设为 1 时不调用 OpenAI，直接回显原图，方便先体验整套界面流程
DEMO_MODE=0

# 品牌信息（显示在页面顶部和底部，用于获客）
BRAND_NAME=XX装修设计
BRAND_CONTACT=添加微信 yourwechat 获取免费报价

# 查看客户线索的口令：访问 /api/leads?token=你的口令 即可看到收集到的线索
ADMIN_TOKEN=changeme
