# 不用 Docker 时的 systemd 方式。
# 1) 把项目放到 /opt/renovation-app  2) 在该目录建好 .env
# 3) cp deploy/renovation.service /etc/systemd/system/
# 4) systemctl daemon-reload && systemctl enable --now renovation

[Unit]
Description=AI Renovation Design App
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/renovation-app
ExecStart=/usr/bin/node server.js
EnvironmentFile=/opt/renovation-app/.env
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
